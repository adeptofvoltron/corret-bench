# Copy to .env (never commit it). Prefer injecting the key from 1Password:
#   op run --env-file=.env.op -- python main.py
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4o              # e.g. gpt-4o-mini, o3-mini
MAX_SAMPLES=50                   # number of tasks
DATASET=mbpp                     # mbpp | bigcodebench-hard | builtin | jsonl:<path>
MAX_CORRECTION_ROUNDS=1          # same budget for intrinsic and grounded
TEMPERATURE=0                    # ignored automatically by reasoning models
EXEC_TIMEOUT_S=10                # bigcodebench-hard tasks use 240 s / 30 GB
EXEC_MEMORY_MB=4096              # 0 = no address-space limit
# EXEC_PYTHON=.venv-bcb/bin/python  # interpreter for generated code; needed for bigcodebench-hard
CONCURRENCY=4
